# Blue Plaque Hunter — environment for the container.
# Copy to `.env` (untracked) on the homelab server, next to the compose file.
# No secrets are required by this app (no auth, no external API keys at runtime).

# --- Database -----------------------------------------------------------------
# SQLite file path INSIDE the container. Must live under /app/data so it lands on
# the persistent named volume (see docker-compose.yml). Do not change the dir
# unless you also change the volume mount.
DATABASE_URL="file:/app/data/plaques.db"

# --- Entrypoint paths (optional; sensible defaults baked in) -------------------
# Root of the writable data volume. DB_FILE must equal the DATABASE_URL path
# (minus the "file:" prefix). Only set these if you move the DB off the default.
DATA_DIR="/app/data"
DB_FILE="/app/data/plaques.db"

# --- Runtime ------------------------------------------------------------------
NODE_ENV="production"
# PORT is the in-container port the server listens on (mapped by compose to 3001
# on the host). Leave at 3000 unless you also change the compose port mapping.
PORT="3000"
